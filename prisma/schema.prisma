// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///
/// ENUMS
///

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum Timeslot {
  MORNING
  MIDDAY
  EVENING
}

///
/// You can add more sources if needed
///
enum Source {
  NOTINO
  EPHORA
  // Add other sources as required
}

///
/// MODELS
///

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Routines that this user has created
  routines   Routine[]

  // Routines that this user has liked
  likes      Like[]

  // Follow relationships:
  // "following" are the Follow records where this user is the follower.
  following  Follow[] @relation("Following")
  // "followers" are the Follow records where this user is being followed.
  followers  Follow[] @relation("Followers")
}

model Routine {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // The creator of the routine
  userId      Int
  author      User            @relation(fields: [userId], references: [id])

  // The grid “cells” for this routine
  entries     RoutineEntry[]

  // Likes on this routine
  likes       Like[]
}

model RoutineEntry {
  id         Int       @id @default(autoincrement())
  routineId  Int
  day        Weekday
  timeslot   Timeslot

  // Link back to the parent routine
  routine    Routine   @relation(fields: [routineId], references: [id])

  // A many-to-many relationship with products.
  // This lets you assign one or several products to this grid cell.
  products   Product[] @relation("RoutineEntryProducts")

  // Ensure each (routine, day, timeslot) combination is unique.
  @@unique([routineId, day, timeslot])
}

model Product {
  id          Int              @id @default(autoincrement())
  name        String
  description String?
  brand       String?
  price       Float?
  url         String?
  source      Source

  // Back–relation to all routine entries that include this product.
  routineEntries RoutineEntry[] @relation("RoutineEntryProducts")
}

///
/// A model for “liking” a routine. This is a join table that records which user liked which routine.
/// An explicit model is used so you can easily add extra fields (e.g. a timestamp) if needed.
///
model Like {
  id         Int      @id @default(autoincrement())
  userId     Int
  routineId  Int
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id])
  routine    Routine  @relation(fields: [routineId], references: [id])
  
  @@unique([userId, routineId])
}

///
/// A model to handle following relationships between users.
/// Each record indicates that a given user (follower) is following another user (following).
///
model Follow {
  id           Int      @id @default(autoincrement())
  followerId   Int
  followingId  Int
  createdAt    DateTime @default(now())

  // The user who is following
  follower     User     @relation("Following", fields: [followerId], references: [id])
  // The user being followed
  following    User     @relation("Followers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}